              "path": ["invoice", ":code", "pdf"],
              "query": [
                {
                  "key": "template",
                  "value": "invoice1",
                  "description": "Template ID (invoice1, invoice2, invoice3)"
                },
                {
                  "key": "preview",
                  "value": "false",
                  "description": "true for preview, false for download"
                }
              ]
            },
            "description": "Download invoice as PDF using HTML templates"
