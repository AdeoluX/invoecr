<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Login Notification</title>
    <!-- Load Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      /* General body styling for email clients */ body { font-family: "Inter",
      sans-serif; background-color: #f7f7f7; margin: 0; padding: 0; line-height:
      1.6; } /* Essential reset for tables in email */ table { border-collapse:
      collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; } /* Ensure images
      scale nicely on mobile */ img { max-width: 100%; height: auto; }
    </style>
    <script>
      tailwind.config = { theme: { extend: { fontFamily: { sans: ["Inter",
      "sans-serif"], }, }, }, };
    </script>
  </head>
  <body class="bg-gray-50 text-gray-700">
    <!-- Outer Wrapper Table for Centering and Max Width -->
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      class="min-w-[320px]"
    >
      <tr>
        <td align="center" class="py-10 sm:py-16">
          <!-- Inner Content Container (Max Width 600px) -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            class="max-w-[600px] bg-white rounded-xl shadow-lg border border-gray-100"
          >
            <!-- Header Logo -->
            <tr>
              <td align="center" class="pt-10 pb-6">
                <img
                  src="https://placehold.co/100x30/FFFFFF/000000?text=Rank+Logo"
                  alt="Rank Logo"
                  width="100"
                  height="30"
                  class="max-w-[100px]"
                  onerror="this.onerror=null;this.src='https://placehold.co/100x30?text=Rank+Logo';"
                />
              </td>
            </tr>

            <!-- Main Content Section -->
            <tr>
              <td class="px-6 sm:px-10 pb-8 pt-4">
                <h1
                  class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug mb-6 text-center"
                >
                  New sign-in detected.
                </h1>

                <p class="text-base text-gray-600 mb-4">
                  Dear
                  {{userName}},
                </p>

                <p class="text-base text-gray-600 mb-6">
                  We noticed a sign-in to your
                  {{appName}}
                  account from a new device or location.
                </p>

                <!-- Login Details Table -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="10"
                  border="0"
                  class="bg-gray-50 border border-gray-200 rounded-lg mb-8 text-sm"
                >
                  <tr>
                    <td width="30%" class="font-medium text-gray-700">Time:</td>
                    <td width="70%" class="text-gray-600">
                      {{loginTime}}
                    </td>
                  </tr>
                  <tr>
                    <td class="font-medium text-gray-700">Device:</td>
                    <td class="text-gray-600">{{device}}</td>
                  </tr>
                  <tr>
                    <td class="font-medium text-gray-700">Location:</td>
                    <td class="text-gray-600">{{location}}</td>
                  </tr>
                </table>

                <!-- CTA Button -->
                <div class="text-center mb-8">
                  <a
                    href="{{securityLink}}"
                    target="_blank"
                    class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-lg text-base shadow-md no-underline"
                  >
                    Review Activity
                  </a>
                </div>

                <p
                  class="text-sm text-gray-500 text-center border-t pt-4 border-gray-100"
                >
                  If this was you, you can safely ignore this email. If this
                  wasn't you, click
                  <strong>Review Activity</strong>
                  immediately to secure your account.
                </p>
              </td>
            </tr>

            <!-- Footer Section (Unchanged) -->
            <tr>
              <td
                align="center"
                class="pt-8 pb-10 px-6 sm:px-10 bg-gray-50 border-t border-gray-100 rounded-b-xl"
              >
                <!-- Footer Logo -->
                <img
                  src="https://placehold.co/80x24/F9FAFB/000000?text=Rank+Logo"
                  alt="Rank Logo"
                  width="80"
                  height="24"
                  class="max-w-[80px] mb-6"
                  onerror="this.onerror=null;this.src='https://placehold.co/80x24?text=Rank+Logo';"
                />

                <p class="text-xs text-gray-500 max-w-[450px] mb-4 text-center">
                  <strong>Confidentiality Notice:</strong>
                  This email and any files transmitted with it are intended
                  solely for the use of the individual or entity to whom they
                  are addressed. If you have received this email in error,
                  please notify the sender immediately.
                </p>

                <p class="text-sm font-medium text-gray-600 text-center">
                  Contact us
                  <a
                    href="mailto:{{supportEmail}}"
                    class="text-indigo-600 hover:text-indigo-700 underline"
                  >{{supportEmail}}</a>
                  or Call
                  <strong>{{supportPhone}}</strong>
                </p>
              </td>
            </tr>
          </table>
          <!-- End Inner Content Container -->
        </td>
      </tr>
    </table>
    <!-- End Outer Wrapper Table -->
  </body>
</html>